# Environment file TEMPLATE for the IDX self-host stack.
#
# Copy this file to `.env` in the same directory as docker-compose.yml, then set
# a real passcode. `.env` must never be committed or shared.
#
#   cp .env.example .env
#   chmod 600 .env
#   openssl rand -hex 24          # -> paste the output as the value below
#
# The value protects the admin actions on the leaderboard page (clear the board)
# and the /admin analytics dashboard. The app has a built-in fallback passcode
# ("clear2026") that MUST NOT be used in production: docker-compose.yml has no
# default, so the stack will not start unless this variable is set.

LEADERBOARD_ADMIN_PASSCODE=REPLACE-WITH-A-GENERATED-VALUE
